<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiclean.externalclean.mapper.ExternalCleanTaskMapper">

    <select id="selectProcessingWithoutCallback" resultType="com.aiclean.externalclean.entity.ExternalCleanTaskEntity">
        SELECT *
        FROM external_clean_task
        WHERE status = 'processing'
          AND callback_received_at IS NULL
    </select>

</mapper>
